# ---- Database ----
DATABASE_URL=postgresql+psycopg://agentquality:agentquality@db:5432/agentquality
POSTGRES_USER=agentquality
POSTGRES_PASSWORD=agentquality
POSTGRES_DB=agentquality

# ---- Security ----
# Signs session/JWT tokens for the password gate. Change in production.
SECRET_KEY=dev-insecure-change-me
# Fernet key for encrypting stored secrets (Dataverse SP secret, Foundry key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# First-run admin bootstrap (only created when no app users exist yet).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ---- Host ports ----
# Only the host-side ports are configurable; change these if 5432/8000/5173
# clash with other stacks running on the same machine. Container-internal ports
# are unchanged, so DATABASE_URL and the api:8000 proxy target stay the same.
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=5173

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_DIST=frontend/dist

# ---- Scan tuning ----
SCAN_CONCURRENCY=8
