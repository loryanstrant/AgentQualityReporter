{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": false,
      "basics": {
        "description": "Deploy the **Copilot Studio Agent Quality Reporter** to Azure Container Apps. It pulls prebuilt public images, provisions a PostgreSQL flexible server, and serves the dashboard on a public HTTPS endpoint. You only need to set an admin password.",
        "location": {
          "label": "Region",
          "toolTip": "Azure region for all resources.",
          "resourceTypes": [
            "Microsoft.App/managedEnvironments",
            "Microsoft.DBforPostgreSQL/flexibleServers"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "namePrefix",
        "type": "Microsoft.Common.TextBox",
        "label": "Resource name prefix",
        "defaultValue": "agentqa",
        "toolTip": "Short prefix (letters and numbers) used to name every resource.",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-z0-9]{2,12}$",
              "message": "2-12 lowercase letters or numbers."
            }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "app",
        "label": "Application",
        "elements": [
          {
            "name": "adminUsername",
            "type": "Microsoft.Common.TextBox",
            "label": "Dashboard admin username",
            "defaultValue": "admin",
            "toolTip": "Username for the first sign-in to the dashboard.",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[A-Za-z0-9._-]{3,32}$",
                  "message": "3-32 characters: letters, numbers, dot, underscore or hyphen."
                }
              ]
            }
          },
          {
            "name": "adminPassword",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Dashboard admin password",
              "confirmPassword": "Confirm password"
            },
            "toolTip": "Password for the first sign-in. Use at least 8 characters with a mix of types.",
            "constraints": {
              "required": true,
              "regex": "^.{8,}$",
              "validationMessage": "At least 8 characters."
            },
            "options": {
              "hideConfirmation": false
            }
          }
        ]
      },
      {
        "name": "sso",
        "label": "Entra SSO (optional)",
        "elements": [
          {
            "name": "ssoInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Optionally let licensed users open the dashboard with their Microsoft work account (Container Apps Easy Auth). The admin console stays password-protected regardless. Leave disabled to use only the admin password. When enabled, register an app and paste its client ID and secret below, then add the redirect URI shown in the deployment outputs."
            }
          },
          {
            "name": "enableEntraAuth",
            "type": "Microsoft.Common.CheckBox",
            "label": "Enable Entra ID single sign-on",
            "toolTip": "Gate the dashboard behind Microsoft Entra ID sign-in."
          },
          {
            "name": "entraClientId",
            "type": "Microsoft.Common.TextBox",
            "label": "Entra application (client) ID",
            "toolTip": "Application (client) ID of the sign-in app registration.",
            "visible": "[steps('sso').enableEntraAuth]",
            "constraints": {
              "required": "[steps('sso').enableEntraAuth]",
              "validations": [
                {
                  "regex": "^[0-9a-fA-F-]{36}$",
                  "message": "A GUID (application/client ID)."
                }
              ]
            }
          },
          {
            "name": "entraClientSecret",
            "type": "Microsoft.Common.PasswordBox",
            "label": {
              "password": "Entra client secret",
              "confirmPassword": "Confirm secret"
            },
            "toolTip": "A client secret for the sign-in app registration.",
            "visible": "[steps('sso').enableEntraAuth]",
            "constraints": {
              "required": "[steps('sso').enableEntraAuth]"
            },
            "options": {
              "hideConfirmation": true
            }
          }
        ]
      },
      {
        "name": "advanced",
        "label": "Advanced",
        "elements": [
          {
            "name": "advancedInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Defaults are fine for most deployments. The image tag controls which published build is deployed."
            }
          },
          {
            "name": "imageTag",
            "type": "Microsoft.Common.TextBox",
            "label": "Image tag",
            "defaultValue": "latest",
            "toolTip": "Container image tag to deploy (e.g. 'latest' or a version tag).",
            "constraints": {
              "required": true,
              "validations": [
                {
                  "regex": "^[A-Za-z0-9._-]{1,64}$",
                  "message": "A valid image tag."
                }
              ]
            }
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "namePrefix": "[basics('namePrefix')]",
      "adminUsername": "[steps('app').adminUsername]",
      "adminPassword": "[steps('app').adminPassword]",
      "enableEntraAuth": "[steps('sso').enableEntraAuth]",
      "entraClientId": "[steps('sso').entraClientId]",
      "entraClientSecret": "[steps('sso').entraClientSecret]",
      "imageTag": "[steps('advanced').imageTag]"
    }
  }
}
